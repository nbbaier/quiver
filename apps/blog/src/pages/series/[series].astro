---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const seriesKeys = new Set(posts.map(p => p.data.series || 'Other'));
  
  return Array.from(seriesKeys).map(seriesKey => ({
    params: { series: seriesKey.toLowerCase() },
    props: { seriesKey },
  }));
}

const { seriesKey } = Astro.props;
const posts = await getCollection('posts');
const seriesPosts = posts.filter(p => (p.data.series || 'Other') === seriesKey);

// Sort posts
seriesPosts.sort((a, b) => {
  const slugA = a.data.slug || a.id;
  const slugB = b.data.slug || b.id;
  return slugA.localeCompare(slugB);
});

const seriesTitle = seriesPosts[0]?.data.seriesTitle || seriesKey;

const guides = await getCollection('guides');
const guide = guides.find(g => g.data.series.toLowerCase() === seriesKey.toLowerCase());
---

<Layout title={seriesTitle}>
  <div class="mb-12 border-b border-gray-200 pb-8">
    <a href="/" class="inline-flex items-center text-sm text-gray-500 hover:text-blue-600 mb-6 transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back to All Series
    </a>
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight mb-2">
      {seriesTitle}
    </h1>
    <p class="text-gray-500 text-lg">
      {seriesPosts.length} Chapters
    </p>
    
    {guide && (
      <div class="mt-6">
        <a href={`/series/${seriesKey.toLowerCase()}/guide`} class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
          View Implementation Guide
        </a>
      </div>
    )}
  </div>

  <div class="grid gap-6 md:grid-cols-1 max-w-3xl mx-auto">
    {seriesPosts.map((post) => (
      <a 
        href={`/posts/${post.data.slug || post.id.replace(/\.md$/, '')}`}
        class="block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md hover:border-blue-300 transition-all duration-200 group"
      >
        <div class="p-6 md:p-8">
          <div class="mb-2">
            <span class="text-blue-600/80 font-semibold text-sm uppercase tracking-wider">
               {seriesTitle}
            </span>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
            {post.data.title}
          </h2>
           <div class="text-gray-400 text-sm flex items-center mt-4">
            Read Chapter <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
           </div>
        </div>
      </a>
    ))}
  </div>
</Layout>
