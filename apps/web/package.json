		"@vercel/node": "^5.7.15",
		"ai": "^6.0.174",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.16",
		"idb": "^8.0.3",
		"inngest": "^4.2.6",
		"lucide-react": "^1.14.0",
