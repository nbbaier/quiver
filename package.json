		"@tailwindcss/vite": "^4.1.17",
		"ai": "^5.0.99",
		"drizzle-orm": "^0.44.7",
		"hono": "^4.10.6",
		"idb": "^8.0.3",
		"lucide-react": "^0.554.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.17"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
